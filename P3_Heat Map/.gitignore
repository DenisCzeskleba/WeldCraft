# Earlier development iterations and scratch notes are preserved locally only.
/00_Development_Archive/

# Measurement inputs and workbooks are local only.
/01_Resources/*
!/01_Resources/.gitkeep
!/01_Resources/config_default.py

# Generated datasets, figures, and animations are local only.
/02_Results/*
!/02_Results/.gitkeep

# Runtime artifacts.
__pycache__/
*.py[cod]
*.h5
*.hdf5
*.mp4

# User-editable persistent GUI configuration.
/03_CodeBase/config.py
